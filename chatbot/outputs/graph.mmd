	order_status_tools --> order_status;
	product_recommendation -.-> __end__;
	product_recommendation -. &nbsp;tools&nbsp; .-> product_recommendation_tools;
	product_recommendation_tools --> product_recommendation;
	refund -.-> __end__;
	refund -. &nbsp;tools&nbsp; .-> refund_tools;
	refund_tools --> refund;
	router -.-> general;
	router -.-> order_status;
	router -.-> product_recommendation;
	router -.-> refund;
	general --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
